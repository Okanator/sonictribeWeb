---
layout: base.njk
title: "SonicTribe – glasbena agencija 360°"
pageCss: /css/motion.css
scripts: ["/js/site.js", "/js/lenis.min.js", "/js/motion.js"]
---
<header class="st-hd"><div class="st-hd-in"><div class="st-radio-pill"><span class="st-radio-dot"></span><a href="#" class="st-radio-art" aria-label="Podrobnosti o skladbi"></a><div class="st-radio-txt"><span class="st-radio-name">SonicTribe Radio</span><span class="st-radio-now">Celoten katalog, naključno</span></div><a href="#" class="st-radio-btn" aria-label="Predvajaj radio">▶</a></div><div class="st-hd-soc">{% set so = site.socialna_omrezja %}{% if so.instagram %}<a href="{{ so.instagram }}" target="_blank" rel="noopener" aria-label="Instagram" class="st-soc"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5" fill="none" stroke="currentColor" stroke-width="1.8"/><circle cx="12" cy="12" r="4.2" fill="none" stroke="currentColor" stroke-width="1.8"/><circle cx="17.4" cy="6.6" r="1.2" fill="currentColor"/></svg></a>{% endif %}{% if so.facebook %}<a href="{{ so.facebook }}" target="_blank" rel="noopener" aria-label="Facebook" class="st-soc"><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M13.5 21v-7.6h2.6l.4-3h-3V8.5c0-.9.3-1.5 1.6-1.5h1.6V4.3c-.3 0-1.2-.1-2.3-.1-2.3 0-3.9 1.4-3.9 4v2.2H7.9v3h2.6V21h3z"/></svg></a>{% endif %}{% if so.youtube %}<a href="{{ so.youtube }}" target="_blank" rel="noopener" aria-label="YouTube" class="st-soc"><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M21.6 7.2a2.5 2.5 0 0 0-1.8-1.8C18.2 5 12 5 12 5s-6.2 0-7.8.4a2.5 2.5 0 0 0-1.8 1.8C2 8.8 2 12 2 12s0 3.2.4 4.8a2.5 2.5 0 0 0 1.8 1.8c1.6.4 7.8.4 7.8.4s6.2 0 7.8-.4a2.5 2.5 0 0 0 1.8-1.8c.4-1.6.4-4.8.4-4.8s0-3.2-.4-4.8zM10 15.1V8.9l5.2 3.1-5.2 3.1z"/></svg></a>{% endif %}</div><div class="st-np" aria-hidden="true"><div class="st-np-art"></div><div class="st-np-body"><p class="st-np-label">Zdaj na SonicTribe Radiu</p><p class="st-np-title">—</p><p class="st-np-artist">—</p><p class="st-np-meta"><span>—</span> · <span>—</span></p><div class="st-np-links"><a href="#" class="st-np-link" data-svc="spotify">Spotify</a><a href="#" class="st-np-link" data-svc="apple">Apple Music</a><a href="#" class="st-np-link" data-svc="youtube">YouTube</a><a href="#" class="st-np-link" data-svc="deezer">Deezer</a><a href="#" class="st-np-link" data-svc="tidal">Tidal</a></div><div class="st-vol"><button type="button" class="st-vol-mute" aria-label="Utišaj">🔊</button><input type="range" class="st-vol-range" min="0" max="1" step="0.01" value="1" aria-label="Glasnost"></div><p class="st-np-next-h">Naslednja</p><div class="st-np-next"></div><p class="st-np-history-h">Pravkar predvajano</p><div class="st-np-history"></div></div></div><a href="#" class="st-burger" aria-expanded="false" aria-label="Odpri meni"><span class="st-burger-line"></span><span class="st-burger-line"></span><span class="st-burger-line"></span></a></div></header><section class="st-hx" id="360">
  <div class="st-hx-bg" style="background-image:url('{{ site.uvod.slika }}')"></div>
  <div class="st-hx-shade"></div>
  <div class="st-wrap st-hx-in">
    <img src="/img/brand/sonictribe-logo-white.png" alt="SonicTribe" class="st-hx-logo">
    <h1 class="st-hx-h">{{ site.uvod.naslov }}</h1>
    <p class="st-hx-p">{{ site.opis }}</p>
    <div class="st-hx-btns">
      <a href="#storitev-1" class="st-btn st-btn-light">{{ site.uvod.gumb_dogodek }}</a>
      <a href="#storitev-2" class="st-btn st-btn-ghost">{{ site.uvod.gumb_kampanja }}</a>
    </div>
  </div>
  <a href="#kajdelamo" class="st-hx-down" aria-label="Naprej"><span></span></a>
</section><div class="st-mq" aria-hidden="true"><div class="st-mq-track">{% set sv = ["Koncerti","Booking","Management","PR","Merch","Kampanje","Radio"] %}{% set ar = [] %}{% for x in collections.izvajalci %}{% if x.data.na_prvi_strani !== false %}{% set ar = (ar.push(x), ar) %}{% endif %}{% endfor %}{% for w in sv %}<span class="st-mq-item">{{ w }}</span>{% if ar[loop.index0 % ar.length] %}<span class="st-mq-item st-mq-out">{{ ar[loop.index0 % ar.length].data.title }}</span>{% endif %}{% endfor %}</div></div>
<section class="st-sx" id="kajdelamo">
  <div class="st-sx-label"><span>Kaj delamo</span></div>
  {% for v in site.storitve %}
  <article class="st-sx-card" id="storitev-{{ loop.index }}">
    <div class="st-sx-inner">
      <div class="st-sx-img" style="background-image:url('{{ v.slika }}');background-position:{{ v.fokus or '50% 50%' }}"></div>
      <div class="st-sx-shade"></div>
      <div class="st-wrap st-sx-content">
        <h2 class="st-sx-t">{{ v.naslov }}</h2>
        <p class="st-sx-p">{{ v.opis }}</p>
        <div class="st-sx-btns">
          <a href="/storitve/{{ v.slug }}/" class="st-btn st-btn-light">Več o storitvi →</a>
          <a href="mailto:{{ v.email }}?subject={{ v.zadeva | urlencode }}" class="st-sx-mail">{{ v.gumb }}</a>
        </div>
      </div>
    </div>
  </article>
  {% endfor %}
</section>
<section class="st-hero" id="smo"><div class="st-wrap st-hero-wrap"><p class="st-kicker">Glasbena agencija 360°</p><h1 class="st-hero-h">Smo vaš <span class="st-rot"><span class="st-rot-in"><span class="st-rot-w">management</span><span class="st-rot-w">booking</span><span class="st-rot-w">PR</span><span class="st-rot-w">merch</span><span class="st-rot-w">management</span></span></span></h1><p class="st-hero-p">SonicTribe ni založba. Smo kreativni in strateški partner, ki umetnikom pomaga razviti njihov potencial in ustvariti trajno, uspešno kariero.</p><div class="st-art-grid st-art-big" id="izvajalci">{% for a in collections.izvajalci %}{% if a.data.na_prvi_strani !== false %}<a href="{{ a.url }}" class="st-art-card"><div class="st-art-photo" style="background-image:url('{{ a.data.fotografija }}');background-position:{{ a.data.fokus or '50% 40%' }}"></div><span class="st-art-name">{{ a.data.title }}</span><span class="st-art-more">Spoznaj izvajalca →</span></a>{% endif %}{% endfor %}</div></div></section><section class="st-vx" id="videospoti">
  <div class="st-vx-pin">
    <div class="st-wrap st-vx-head"><span class="st-vx-k">Videospoti</span><h2 class="st-vx-h">Najnovejši videospoti</h2></div>
    <div class="st-vx-track">{% for v in collections.videospoti | head(6) %}{% set id = v.data.youtube | ytid %}
      <div class="st-vx-slide">
        <div class="st-yt st-vx-yt" data-yt="{{ id }}"><img src="https://i.ytimg.com/vi/{{ id }}/maxresdefault.jpg" onerror="this.onerror=null;this.src='https://i.ytimg.com/vi/{{ id }}/hqdefault.jpg'" alt="{{ v.data.izvajalec }} – {{ v.data.title }}" loading="lazy"><button type="button" class="st-yt-play" aria-label="Predvajaj videospot {{ v.data.title }}">▶</button></div>
        <div class="st-vx-cap"><span class="st-vx-n">0{{ loop.index }}</span><span class="st-vx-t">{{ v.data.title }}</span><span class="st-vx-a">{{ v.data.izvajalec }}</span></div>
      </div>{% endfor %}
    </div>
  </div>
</section><section class="st-shop-sec" id="trgovina"><div class="st-wrap st-shop-wrap"><div class="st-dos-head"><h2 class="st-h-mid">Trgovina</h2><a href="https://sonictribe-shop.sumupstore.com" class="st-kicker st-link-more">Celotna trgovina →</a></div><div>
<div class="w-dyn-list"><div role="list" class="st-shop-list w-dyn-items">{%- set izbrani = [] -%}{%- for x in collections.izdelki %}{% if x.data.na_prvi_strani %}{% set izbrani = (izbrani.push(x), izbrani) %}{% endif %}{% endfor -%}
{%- if not izbrani.length %}{% set izbrani = collections.izdelki %}{% endif -%}
{% for p in izbrani | head(8) %}<div role="listitem" class="w-dyn-item"><div class="st-shop-item">{% if p.data.slika %}<img src="{{ p.data.slika }}" alt="{{ p.data.title }}" loading="lazy" class="st-shop-img">{% endif %}<div class="st-shop-format">{{ p.data.format }}</div><div class="st-shop-name">{{ p.data.title }}</div><div class="st-shop-row"><div class="st-shop-price">{{ p.data.cena }}</div><a href="{{ p.data.sumup }}" target="_blank" rel="noopener" class="st-buy">Kupi</a></div></div></div>{% endfor %}</div></div>
</div><p class="st-lead">Plačilo poteka varno prek SumUp.</p></div></section><section class="st-bp-sec"><div class="st-wrap st-bp-wrap"><div class="st-bp-col st-mg-col" id="management"><h2 class="st-h-small st-red">{{ site.kontakt.naslov }}</h2><div class="st-bp-name">{{ site.kontakt.podjetje }}</div><div class="st-mg-data">{% for l in site.kontakt.vrstice %}<div{% if loop.index == 3 %} class="st-mg-gap"{% endif %}>{{ l }}</div>{% endfor %}</div><a href="mailto:{{ site.kontakt.email }}" class="st-mg-mail-1">{{ site.kontakt.email }}</a></div><div class="st-bp-col st-tm-col" id="booking"><h2 class="st-h-small st-red">Ekipa</h2>{% for m in site.ekipa %}<div class="st-tm-row"><div class="st-tm-role">{{ m.vloga }}</div><div class="st-tm-name">{{ m.ime }}</div><a href="mailto:{{ m.email }}" class="st-tm-mail">{{ m.email }}</a>{% if m.telefon %}<a href="tel:{{ m.telefon | replace(' ','') }}" class="st-tm-tel">{{ m.telefon }}</a>{% endif %}</div>{% endfor %}</div></div></section><div class="st-ptx" id="sodelovali"><div class="st-wrap st-ptx-in"><span class="st-ptx-k">Sodelovali smo z</span><ul class="st-ptx-list">{% for n in site.partnerji %}<li>{{ n }}</li>{% endfor %}</ul></div></div>
<footer class="st-footer" id="kontakt"><div class="st-wrap st-footer-wrap"><img src="/img/brand/sonictribe-logo-white.png" alt="SonicTribe" class="st-footer-logo"><a href="mailto:st@sonictribe.net" class="st-footer-mail">st@sonictribe.net</a><nav class="st-footer-nav"><a href="{{ site.socialna_omrezja.facebook }}" target="_blank" rel="noopener" class="st-footer-link">Facebook</a><a href="{{ site.socialna_omrezja.instagram }}" target="_blank" rel="noopener" class="st-footer-link">Instagram</a><a href="{{ site.socialna_omrezja.youtube }}" target="_blank" rel="noopener" class="st-footer-link">YouTube</a><a href="https://sonictribe-shop.sumupstore.com/page/terms-and-conditions" target="_blank" rel="noopener" class="st-footer-link">Splošni pogoji</a></nav><span class="st-footer-small">sonictribe.net</span></div></footer><a href="#management" class="st-fab" aria-label="Pišite nam"><svg viewBox="0 0 100 100" aria-hidden="true"><defs><path id="st-fab-c" d="M50,50 m-37,0 a37,37 0 1,1 74,0 a37,37 0 1,1 -74,0"/></defs><text><textPath href="#st-fab-c">PIŠITE NAM · PIŠITE NAM · PIŠITE NAM · </textPath></text></svg><span class="st-fab-i">✉</span></a>
<div class="st-menu" aria-hidden="true"><div class="st-menu-in"><div class="st-menu-top"><img src="/img/brand/sonictribe-logo-white.png" alt="SonicTribe" class="st-menu-logo"><a href="#" class="st-menu-close" aria-label="Zapri meni">✕</a></div><nav class="st-menu-nav"><a href="#360" class="st-menu-link">Domov</a><a href="#kajdelamo" class="st-menu-link">Kaj delamo</a><a href="#izvajalci" class="st-menu-link">Izvajalci</a><a href="#videospoti" class="st-menu-link">Videospoti</a><a href="#trgovina" class="st-menu-link">Trgovina</a><a href="#booking" class="st-menu-link">Booking</a><a href="#kontakt" class="st-menu-link">Kontakt</a></nav><div class="st-menu-foot"><a href="mailto:st@sonictribe.net" class="st-menu-small">st@sonictribe.net</a><a href="{{ site.socialna_omrezja.facebook }}" target="_blank" rel="noopener" class="st-menu-small">Facebook</a><a href="{{ site.socialna_omrezja.instagram }}" target="_blank" rel="noopener" class="st-menu-small">Instagram</a><a href="{{ site.socialna_omrezja.youtube }}" target="_blank" rel="noopener" class="st-menu-small">YouTube</a></div></div></div>
