---
layout: base.njk
title: "SonicTribe – glasbena agencija 360°"
pageCss: /css/motion.css
scripts: ["/js/site.js", "/js/motion.js"]
---
<header class="st-hd"><div class="st-hd-in"><div class="st-radio-pill"><span class="st-radio-dot"></span><a href="#" class="st-radio-art" aria-label="Podrobnosti o skladbi"></a><div class="st-radio-txt"><span class="st-radio-name">SonicTribe Radio</span><span class="st-radio-now">Celoten katalog, naključno</span></div><a href="#" class="st-radio-btn" aria-label="Predvajaj radio">▶</a></div><div class="st-hd-sec">SonicTribe</div><div class="st-np" aria-hidden="true"><div class="st-np-art"></div><div class="st-np-body"><p class="st-np-label">Zdaj na SonicTribe Radiu</p><p class="st-np-title">—</p><p class="st-np-artist">—</p><p class="st-np-meta"><span>—</span> · <span>—</span></p><div class="st-np-links"><a href="#" class="st-np-link" data-svc="spotify">Spotify</a><a href="#" class="st-np-link" data-svc="apple">Apple Music</a><a href="#" class="st-np-link" data-svc="youtube">YouTube</a><a href="#" class="st-np-link" data-svc="deezer">Deezer</a><a href="#" class="st-np-link" data-svc="tidal">Tidal</a></div><p class="st-np-history-h">Pravkar predvajano</p><div class="st-np-history"></div></div></div><a href="#" class="st-burger" aria-expanded="false" aria-label="Odpri meni"><span class="st-burger-line"></span><span class="st-burger-line"></span><span class="st-burger-line"></span></a></div></header><section class="st-360-sec" id="360"><div class="st-wrap st-360-wrap"><div class="st-360-left"><img src="/img/brand/sonictribe-logo-black.png" alt="SonicTribe" class="st-360-logo"><div class="st-360-num">360°</div><p class="st-360-claim">{{ site.trditev }}</p></div><div class="st-360-right"><p class="st-360-p">{{ site.opis }}</p></div></div></section><div class="st-mq" aria-hidden="true"><div class="st-mq-track">{% set sv = ["Koncerti","Booking","Management","PR","Merch","Kampanje","Radio"] %}{% set ar = collections.izvajalci %}{% for w in sv %}<span class="st-mq-item">{{ w }}</span>{% if ar[loop.index0 % ar.length] %}<span class="st-mq-item st-mq-out">{{ ar[loop.index0 % ar.length].data.title }}</span>{% endif %}{% endfor %}</div></div>
<section class="st-pl-sec" id="naredili"><div class="st-wrap st-pl-wrap"><a href="#naredili" class="st-pl-head"><span class="st-pl-head-t">Skupaj smo ustvarili…</span><span class="st-pl-head-i">+</span></a><div class="st-pl-items">
<div class="w-dyn-list"><div role="list" class="w-dyn-items">{% for d in collections.dosezki %}<div role="listitem" class="w-dyn-item"><div class="st-pl-item">{% if d.data.fotografija %}<img src="{{ d.data.fotografija }}" alt="{{ d.data.title }}" loading="lazy" class="st-pl-img">{% endif %}<div class="st-pl-year">{{ d.data.datum }}</div><div class="st-pl-cat">{{ d.data.kategorija }}</div><div class="st-pl-big">{{ d.data.velik_napis }}</div><div class="st-pl-artist">{{ d.data.izvajalec }}</div><div class="st-pl-name">{{ d.data.title }}</div><div class="st-pl-text">{{ d.data.opis }}</div><a href="{{ d.url }}" class="st-pl-cta"><span class="st-pl-cta-ar">▶</span><div class="st-pl-cta-t">{{ d.data.poziv or "več" }}</div></a></div></div>{% endfor %}</div></div>
</div><a href="#naredili" class="st-pl-more">Pokaži vse, kar smo ustvarili</a></div></section><section class="st-hero" id="kajdelamo"><div class="st-wrap st-hero-wrap"><p class="st-kicker">Glasbena agencija 360°</p><h1 class="st-hero-h">Smo vaš <span class="st-rot"><span class="st-rot-in"><span class="st-rot-w">management</span><span class="st-rot-w">booking</span><span class="st-rot-w">PR</span><span class="st-rot-w">merch</span><span class="st-rot-w">management</span></span></span></h1><p class="st-hero-p">SonicTribe ni založba. Smo kreativni in strateški partner, ki umetnikom pomaga razviti njihov potencial in ustvariti trajno, uspešno kariero.</p><div class="st-art-grid" id="izvajalci">{% for a in collections.izvajalci %}<a href="{{ a.url }}" class="st-art-card"><div class="st-art-photo" style="background-image:url('{{ a.data.fotografija }}');background-position:{{ a.data.fokus or '50% 40%' }}"></div><span class="st-art-name">{{ a.data.title }}</span></a>{% endfor %}</div></div></section><section class="st-vid-sec" id="videospoti"><div class="st-wrap st-vid-wrap" id="domov"><div class="st-vid-head"><p class="st-kicker st-kicker-light">Videospoti</p><p class="st-vid-tag">Najnovejši videospoti</p></div><div>
<div class="w-dyn-list"><div role="list" class="st-vg-list w-dyn-items">{% for v in collections.videospoti | head(6) %}<div role="listitem" class="w-dyn-item"><div class="st-vg-item"><div class="st-yt" data-yt="{{ v.data.youtube | ytid }}"><img src="https://i.ytimg.com/vi/{{ v.data.youtube | ytid }}/hqdefault.jpg" alt="{{ v.data.izvajalec }} – {{ v.data.title }}" loading="lazy"><button type="button" class="st-yt-play" aria-label="Predvajaj videospot {{ v.data.title }}">▶</button></div><div class="st-vg-title">{{ v.data.title }}</div><div class="st-vg-artist">{{ v.data.izvajalec }}</div></div></div>{% endfor %}</div></div>
</div></div></section><section class="st-shop-sec" id="trgovina"><div class="st-wrap st-shop-wrap"><div class="st-dos-head"><h2 class="st-h-mid">Trgovina</h2><a href="https://sonictribe-shop.sumupstore.com" class="st-kicker st-link-more">Celotna trgovina →</a></div><div>
<div class="w-dyn-list"><div role="list" class="st-shop-list w-dyn-items">{% for p in collections.izdelki %}<div role="listitem" class="w-dyn-item"><div class="st-shop-item">{% if p.data.slika %}<img src="{{ p.data.slika }}" alt="{{ p.data.title }}" loading="lazy" class="st-shop-img">{% endif %}<div class="st-shop-format">{{ p.data.format }}</div><div class="st-shop-name">{{ p.data.title }}</div><div class="st-shop-row"><div class="st-shop-price">{{ p.data.cena }}</div><a href="{{ p.data.sumup }}" target="_blank" rel="noopener" class="st-buy">Kupi</a></div></div></div>{% endfor %}</div></div>
</div><p class="st-lead">Plačilo poteka varno prek SumUp.</p></div></section><section class="st-bp-sec"><div class="st-wrap st-bp-wrap"><div class="st-bp-col st-mg-col" id="management"><h2 class="st-h-small st-red">{{ site.kontakt.naslov }}</h2><div class="st-bp-name">{{ site.kontakt.podjetje }}</div><div class="st-mg-data">{% for l in site.kontakt.vrstice %}<div{% if loop.index == 3 %} class="st-mg-gap"{% endif %}>{{ l }}</div>{% endfor %}</div><a href="mailto:{{ site.kontakt.email }}" class="st-mg-mail-1">{{ site.kontakt.email }}</a></div><div class="st-bp-col st-tm-col" id="booking"><h2 class="st-h-small st-red">Ekipa</h2>{% for m in site.ekipa %}<div class="st-tm-row"><div class="st-tm-role">{{ m.vloga }}</div><div class="st-tm-name">{{ m.ime }}</div><a href="mailto:{{ m.email }}" class="st-tm-mail">{{ m.email }}</a>{% if m.telefon %}<a href="tel:{{ m.telefon | replace(' ','') }}" class="st-tm-tel">{{ m.telefon }}</a>{% endif %}</div>{% endfor %}</div></div></section><footer class="st-footer" id="kontakt"><div class="st-wrap st-footer-wrap"><img src="/img/brand/sonictribe-logo-white.png" alt="SonicTribe" class="st-footer-logo"><a href="mailto:st@sonictribe.net" class="st-footer-mail">st@sonictribe.net</a><nav class="st-footer-nav"><a href="{{ site.socialna_omrezja.facebook }}" target="_blank" rel="noopener" class="st-footer-link">Facebook</a><a href="{{ site.socialna_omrezja.instagram }}" target="_blank" rel="noopener" class="st-footer-link">Instagram</a><a href="{{ site.socialna_omrezja.youtube }}" target="_blank" rel="noopener" class="st-footer-link">YouTube</a><a href="https://sonictribe-shop.sumupstore.com/page/terms-and-conditions" target="_blank" rel="noopener" class="st-footer-link">Splošni pogoji</a></nav><span class="st-footer-small">sonictribe.net</span></div></footer><div class="st-menu" aria-hidden="true"><div class="st-menu-in"><div class="st-menu-top"><img src="/img/brand/sonictribe-logo-white.png" alt="SonicTribe" class="st-menu-logo"><a href="#" class="st-menu-close" aria-label="Zapri meni">✕</a></div><nav class="st-menu-nav"><a href="#360" class="st-menu-link">360°</a><a href="#naredili" class="st-menu-link">Kaj smo naredili</a><a href="#kajdelamo" class="st-menu-link">Kaj delamo</a><a href="#videospoti" class="st-menu-link">Videospoti</a><a href="#trgovina" class="st-menu-link">Trgovina</a><a href="#booking" class="st-menu-link">Booking</a><a href="#management" class="st-menu-link">Management</a><a href="#izvajalci" class="st-menu-link">Izvajalci</a><a href="#kontakt" class="st-menu-link">Kontakt</a></nav><div class="st-menu-foot"><a href="mailto:st@sonictribe.net" class="st-menu-small">st@sonictribe.net</a><a href="{{ site.socialna_omrezja.facebook }}" target="_blank" rel="noopener" class="st-menu-small">Facebook</a><a href="{{ site.socialna_omrezja.instagram }}" target="_blank" rel="noopener" class="st-menu-small">Instagram</a><a href="{{ site.socialna_omrezja.youtube }}" target="_blank" rel="noopener" class="st-menu-small">YouTube</a></div></div></div>
