---
pagination:
  data: site.storitve
  size: 1
  alias: s
permalink: "/storitve/{{ s.slug }}/"
layout: base.njk
pageCss: /css/pages.css
scripts: ["/js/pages.js"]
eleventyComputed:
  title: "{{ s.naslov }} – SonicTribe"
  description: "{{ s.opis }}"
  fotografija: "{{ s.slika }}"
---
<div class="st-pj st-sv-page">
  <header class="st-pj-bar"><div class="st-pj-bar-in">
    <a href="/" class="st-pj-home"><img src="/img/brand/sonictribe-logo-black.png" alt="SonicTribe" class="st-pj-logo"></a>
    <div class="st-pj-sec">Kaj delamo</div>
    <a href="/#kajdelamo" class="st-pj-back">← Vse storitve</a>
  </div></header>

  <section class="st-pj-hero">
    <img src="{{ s.slika }}" alt="{{ s.naslov }}" class="st-pj-hero-img" style="object-position:{{ s.fokus or '50% 50%' }}">
    <div class="st-pj-hero-in">
      <div class="st-pj-date">SonicTribe</div>
      <div class="st-pj-big">{{ s.naslov }}</div>
      <h1 class="st-pj-title">{{ s.opis }}</h1>
    </div>
  </section>

  <section class="st-pj-part">
    <div class="st-pj-wrap">
      <div class="st-pj-head"><h2 class="st-pj-h">Kako delamo</h2><div class="st-pj-line"></div></div>
      <div class="st-pj-rt"><div class="w-richtext">{{ s.besedilo | md | safe }}</div></div>
      {% if s.vkljucuje and s.vkljucuje.length %}<ul class="st-sv-list">{% for v in s.vkljucuje %}<li>{{ v }}</li>{% endfor %}</ul>{% endif %}
    </div>
  </section>

  {% if s.slug == 'izidi' and collections.izidi.length %}
  <section class="st-pj-part st-kat-sec">
    <div class="st-pj-wrap">
      <div class="st-pj-head"><h2 class="st-pj-h">Katalog izidov</h2><div class="st-pj-line"></div></div>
      <div class="st-kat">
      {% for r in collections.izidi %}{% set y = (r.data.datum | ymd).slice(0, 4) %}{% set prev = collections.izidi[loop.index0 - 1] %}
        {% if loop.first or (prev.data.datum | ymd).slice(0, 4) != y %}<div class="st-kat-y">{{ y }}</div>{% endif %}
        <a class="st-kat-item" href="{{ r.data.povezava or r.data.apple_music or '#' }}" target="_blank" rel="noopener">
          <span class="st-kat-img"{% if r.data.naslovnica %} style="background-image:url('{{ r.data.naslovnica }}')"{% endif %}></span>
          <span class="st-kat-t">{{ r.title }}</span>
          <span class="st-kat-a">{{ r.data.izvajalec }}</span>
          <span class="st-kat-m">{{ r.data.tip }}</span>
        </a>
      {% endfor %}
      </div>
    </div>
  </section>
  {% endif %}

  {% if s.instagram and s.instagram.length %}
  <section class="st-pj-part st-ig-sec">
    <div class="st-pj-wrap">
      <div class="st-pj-head"><h2 class="st-pj-h">Z družbenih omrežij</h2><div class="st-pj-line"></div></div>
      <div class="st-ig-consent">
        <p>Objave so z Instagrama in Facebooka. Ob prikazu se naloži vsebina z Metinih strežnikov, ki lahko nastavi piškotke.</p>
        <button type="button" class="st-ig-btn">Prikaži objave</button>
      </div>
      <div class="st-ig-grid" hidden>{% for u in s.instagram %}{% set clean = u.split('?')[0] %}
        {%- if 'facebook.com' in clean or 'fb.watch' in clean %}
        <div class="st-fb"><iframe data-src="https://www.facebook.com/plugins/video.php?href={{ clean | urlencode }}&show_text=false&width=560" title="Facebook video" allow="autoplay; clipboard-write; encrypted-media; picture-in-picture; web-share" allowfullscreen loading="lazy"></iframe></div>
        {%- else %}
        <blockquote class="instagram-media" data-instgrm-permalink="{{ clean }}" data-instgrm-version="14"><a href="{{ clean }}" target="_blank" rel="noopener">Poglej objavo na Instagramu</a></blockquote>
        {%- endif %}{% endfor %}
      </div>
    </div>
  </section>
  <script>
  (function () {
    var b = document.querySelector('.st-ig-btn'), g = document.querySelector('.st-ig-grid'), c = document.querySelector('.st-ig-consent');
    function load() { try { localStorage.setItem('st-ig', '1') } catch (e) {} c.remove(); g.hidden = false; g.querySelectorAll('iframe[data-src]').forEach(function (f) { f.src = f.getAttribute('data-src') }); var sc = document.createElement('script'); sc.async = true; sc.src = 'https://www.instagram.com/embed.js'; document.body.appendChild(sc) }
    if (b) b.addEventListener('click', load);
    try { if (localStorage.getItem('st-ig') === '1') load() } catch (e) {}
  })();
  </script>
  {% endif %}

  <section class="st-pj-cta"><div class="st-pj-wrap st-pj-cta-in">
    <div class="st-pj-cta-t">{{ s.gumb }}</div>
    <a href="mailto:{{ s.email }}?subject={{ s.zadeva | urlencode }}" class="st-pj-cta-btn">Pišite nam</a>
    <a href="mailto:{{ s.email }}" class="st-pj-cta-link">{{ s.email }}</a>
  </div></section>
</div>
